new file mode 100644
index 0000000..4aad9a3
--- /dev/null
+++ b/notification_complete_sd.go
@@ -0,0 +1,12 @@
+//go:build softdevice && (s113v7 || s132v6 || s140v6 || s140v7)
+
+package bluetooth
+
+// SetNotificationCompleteHandler registers a callback for Nordic SoftDevice
+// Handle Value Notification transmission completions. count is the number of
+// notification credits freed, not the number of application messages received.
+// The callback runs in the BLE event context: it must be short, nonblocking,
+// and must not perform Bluetooth operations or allocate.
+func (a *Adapter) SetNotificationCompleteHandler(cb func(count uint16)) {
+	a.notificationCompleteHandler = cb
+}
